# Copy to secrets.env (git-ignored) and fill with:
#   atlas-cli keygen    -> ATLAS_GOSSIP_KEY
#   atlas-cli tokengen  -> ATLAS_API_TOKENS (legacy full access)
#   Or set ATLAS_API_CREDENTIALS to a scoped credential JSON array.
ATLAS_GOSSIP_KEY=
ATLAS_GOSSIP_KEYS_SECONDARY=
ATLAS_API_TOKENS=
ATLAS_API_CREDENTIALS=
