# =============================================================================
#  Atlas configuration template
#
#  cp .env.example .env && ./scripts/gen-secrets.sh
#
#  .env is git-ignored. NEVER commit real secrets. In Kubernetes these live in
#  a Secret, on Fly.io in `fly secrets`, in CI in GitHub Actions secrets.
#  Values marked [SECRET] must be generated, never invented by hand.
# =============================================================================
# Optional node config file in KEY=value format; non-empty process environment
# variables override the file.
ATLAS_CONFIG_FILE=

# ---- General ----------------------------------------------------------------
# development | production  (production enforces TLS)
ATLAS_ENV=development
ATLAS_VERSION=dev
# Defaults to the hostname / FLY_REGION when empty
ATLAS_NODE_ID=
ATLAS_REGION=local
# debug | info | warn | error
ATLAS_LOG_LEVEL=info
# json | text
ATLAS_LOG_FORMAT=json

# ---- Gossip / membership (UDP) ----------------------------------------------
# UDP gossip plus TCP full-state push-pull share this host:port.
ATLAS_GOSSIP_BIND_ADDR=0.0.0.0:7946
# Address peers dial; auto-detected when empty (FLY_PRIVATE_IP on Fly.io)
ATLAS_GOSSIP_ADVERTISE_ADDR=
# Comma-separated host:port. DNS names may resolve to many IPs (k8s headless svc)
ATLAS_SEEDS=atlas-1:7946,atlas-2:7946,atlas-3:7946
# Optional allowlist of node IDs. Empty means any node with the gossip key is admitted.
ATLAS_ALLOWED_NODE_IDS=
# [SECRET] base64 256-bit AES-GCM key shared by every node: `atlas-cli keygen`
ATLAS_GOSSIP_KEY=
# [SECRET] Extra decrypt-only keys during rotation (comma-separated base64)
ATLAS_GOSSIP_KEYS_SECONDARY=
# Failure detector and dissemination timing
ATLAS_PROBE_INTERVAL=1s
ATLAS_PROBE_TIMEOUT=500ms
ATLAS_SUSPICION_TIMEOUT=5s
ATLAS_GOSSIP_INTERVAL=200ms
ATLAS_GOSSIP_FANOUT=3
ATLAS_DEAD_NODE_REAP=5m
# Packets older/newer than this are dropped (replay window)
ATLAS_MAX_CLOCK_SKEW=30s

# ---- HTTP API -----------------------------------------------------------------
ATLAS_HTTP_ADDR=0.0.0.0:8080
ATLAS_GRPC_ADDR=0.0.0.0:8082
ATLAS_DB_PATH=data/atlas.db
ATLAS_HEALTH_CHECK_INTERVAL=5s
ATLAS_HEALTH_CHECK_TIMEOUT=1s
# Prometheus scrape endpoint (keep it on a private network)
ATLAS_METRICS_ADDR=0.0.0.0:9090
# Go profiling endpoint is bound to loopback only; use a unique port when
# running multiple node processes on the same host.
ATLAS_PPROF_ADDR=127.0.0.1:6060
# [SECRET] Legacy comma-separated bearer tokens, >= 32 chars; full access, no expiry.
ATLAS_API_TOKENS=
# Optional JSON array of scoped credentials; configure this OR ATLAS_API_TOKENS.
# Example: [{"token":"<32+ chars>","scopes":["read"],"expires_at":"2030-01-01T00:00:00Z"}]
ATLAS_API_CREDENTIALS=
ATLAS_RATE_LIMIT_RPS=20
ATLAS_RATE_LIMIT_BURST=40
# Optional trusted reverse proxy CIDRs; forwarded client IPs are ignored otherwise.
ATLAS_TRUSTED_PROXIES=

# ---- TLS / mTLS ---------------------------------------------------------------
# Generate a local CA + certs with ./scripts/gen-certs.sh
ATLAS_TLS_ENABLED=false
ATLAS_TLS_CERT_FILE=/etc/atlas/tls/server.crt
ATLAS_TLS_KEY_FILE=/etc/atlas/tls/server.key
ATLAS_TLS_CA_FILE=/etc/atlas/tls/ca.crt
# Require client certificates signed by the CA (mutual TLS)
ATLAS_TLS_CLIENT_AUTH=false
# Set true only behind a trusted TLS-terminating proxy (e.g. Fly.io edge)
ATLAS_TLS_TERMINATED_UPSTREAM=false
# Container health check target (switch to https://127.0.0.1:8080 with TLS on)
ATLAS_HEALTHCHECK_ADDR=http://127.0.0.1:8080

# ---- atlas-cli ----------------------------------------------------------------
ATLAS_ADDR=http://127.0.0.1:8081
# [SECRET] An API token from ATLAS_API_TOKENS or ATLAS_API_CREDENTIALS
ATLAS_TOKEN=
ATLAS_CA_FILE=./deploy/certs/ca.crt
ATLAS_CLIENT_CERT=./deploy/certs/client.crt
ATLAS_CLIENT_KEY=./deploy/certs/client.key

# ---- Observability ------------------------------------------------------------
PROMETHEUS_VERSION=v3.5.0
PROMETHEUS_PORT=9091
PROMETHEUS_RETENTION=15d
GRAFANA_VERSION=12.1.1
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
# [SECRET]
GRAFANA_ADMIN_PASSWORD=

# ---- Container registry -------------------------------------------------------
REGISTRY=ghcr.io
IMAGE_NAME=ghcr.io/manziosee/atlas

# ---- Kubernetes ---------------------------------------------------------------
K8S_NAMESPACE=atlas
K8S_CONTEXT=

# ---- Fly.io (multi-region) ----------------------------------------------------
FLY_APP_NAME=atlas-edge
FLY_ORG=personal
FLY_PRIMARY_REGION=jnb
# Johannesburg, Frankfurt, Singapore, Virginia
FLY_REGIONS=jnb,fra,sin,iad
# [SECRET] `fly tokens create deploy` — store in CI secrets, not here, for prod
FLY_API_TOKEN=
