{
  "name": "@manziosee/atlas-client",
  "version": "0.1.0",
  "description": "TypeScript client for the Atlas service-discovery API, with no runtime dependencies",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manziosee/atlas.git",
    "directory": "clients/node"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "README.md",
    "dist/index.d.ts",
    "dist/index.js"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test \"dist/test/**/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  },
  "homepage": "https://github.com/manziosee/atlas/tree/main/clients/node#readme",
  "bugs": {
    "url": "https://github.com/manziosee/atlas/issues"
  },
  "keywords": [
    "service-discovery",
    "service-registry",
    "atlas",
    "load-balancing",
    "typescript"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
